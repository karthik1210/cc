<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="cc-ui_smoke_test">
    <listeners>
        <listener
                class-name="com.intuit.ifs.csscat.core.TestValidationErrorListener"/>
        <listener class-name="org.uncommons.reportng.HTMLReporter"/>
        <listener
                class-name="org.uncommons.reportng.JUnitXMLReporter"/>
        <listener
                class-name="com.epam.reportportal.testng.ReportPortalTestNGListener"/>
    </listeners>
    <test name="UI Smoke Test">

        <groups>
            <run>
                <include name="smoke"></include>
            </run>
        </groups>

        <classes>
            			<class name="com.pxp.cc.testcases.ui.LoginScreenTests" />
            			<class name="com.pxp.cc.testcases.ui.PasswordResetTests" />
            			<class name="com.pxp.cc.testcases.ui.ClientDirectoryTests" />
            			<class name="com.pxp.cc.testcases.ui.CreateClientTests" />
            			<class name="com.pxp.cc.testcases.ui.GeneralSettingsSearchTests" />
            			<class name="com.pxp.cc.testcases.ui.AddOrgNodeTests" />
            			<class name="com.pxp.cc.testcases.ui.EditOrgNodeTest" />
            			<class name="com.pxp.cc.testcases.ui.MoveSystemTests" />
            			<class name="com.pxp.cc.testcases.ui.MoveEnterpriseTests" />
            			<class name="com.pxp.cc.testcases.ui.MoveNgePracticeTests" />
            			<class name="com.pxp.cc.testcases.ui.MoveAgnosticPracticeTests" />
            			<class name="com.pxp.cc.testcases.ui.AddNewInternalUserTests" />
            			<class name="com.pxp.cc.testcases.ui.DeactivateUserTests" />
            			<class name="com.pxp.cc.testcases.ui.EditInternalUserTests" />
            			<class name="com.pxp.cc.testcases.ui.SearchOptionsTests" />
                        <class name="com.pxp.cc.testcases.ui.PracticeLinksTests" />
                        <class name="com.pxp.cc.testcases.ui.PrivacyPolicySettingsTests" />
        </classes>
    </test>
</suite>