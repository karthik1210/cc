<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="cc-ui_smoke_test">
	<listeners>
		<listener
			class-name="com.intuit.ifs.csscat.core.TestValidationErrorListener" />
		<listener class-name="org.uncommons.reportng.HTMLReporter" />
		<listener
			class-name="org.uncommons.reportng.JUnitXMLReporter" />
		<listener
			class-name="com.epam.reportportal.testng.ReportPortalTestNGListener" />
	</listeners>
	<test name="UIBuildTest">
		<groups>
			<run>
				<include name="buildvalidation"></include>
			</run>
		</groups>
		<classes>
			<class name="com.pxp.cc.testcases.ui.ResourcesPageTests" />
			<class name="com.pxp.cc.testcases.ui.LocationsPageTests" />
			<class name="com.pxp.cc.testcases.ui.InterfaceSetupTests" />
			<class name="com.pxp.cc.testcases.ui.PatientAccessDetailsTests"/>
			<class name="com.pxp.cc.testcases.ui.PrivacyPoliciesSettingsTest" />
			<class name="com.pxp.cc.testcases.ui.PracticeLinksTests" />
			<class name="com.pxp.cc.testcases.ui.AddNewInternalUserTests" />
			<class name="com.pxp.cc.testcases.ui.AddNewVarResellerUserTests" />
		</classes>
	</test>
</suite>