<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="cc-ui_smoke_test">
    <listeners>
        <listener
                class-name="com.intuit.ifs.csscat.core.TestValidationErrorListener"/>
        <listener class-name="org.uncommons.reportng.HTMLReporter"/>
        <listener
                class-name="org.uncommons.reportng.JUnitXMLReporter"/>
        <listener
                class-name="com.epam.reportportal.testng.ReportPortalTestNGListener"/>
    </listeners>
    <test name="UI Smoke Test">

        <groups>
            <run>
                <include name="smoke"></include>
            </run>
        </groups>

        <classes>
            <class name="com.pxp.cc.testcases.ui.AddNewInternalUserTests" />
            <class name="com.pxp.cc.testcases.ui.AddNewVarResellerUserTests" />
            <class name="com.pxp.cc.testcases.ui.VarResellerUserLockFromKebabMenuTests" />
            <class name="com.pxp.cc.testcases.ui.InternalUserLockFromKebabMenuTests" />
            <class name="com.pxp.cc.testcases.ui.EditClientUserTests" />
            <class name="com.pxp.cc.testcases.ui.ClientUserLockFromKebabMenuTests" />
        </classes>
    </test>
</suite>