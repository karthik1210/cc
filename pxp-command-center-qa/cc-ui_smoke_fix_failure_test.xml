            <class name="com.pxp.cc.testcases.ui.InternalUserDeactivationFromKebabMenuTests" />
            <class name="com.pxp.cc.testcases.ui.FavoriteUnFavoriteClientsTests" />
            <class name="com.pxp.cc.testcases.ui.EditClientDetailsTests" />
            <class name="com.pxp.cc.testcases.ui.CreateBrandTemplateTests" />
